# Copie este arquivo para `docker/.env` antes de rodar `docker compose up`.
# `docker/.env` nunca deve ser commitado (já está no .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=salesapi
POSTGRES_USER=salesapi
POSTGRES_PASSWORD=salesapi
POSTGRES_PORT=5432

# --- SalesApi.Api ---
# Connection string consumida pela Api é montada automaticamente pelo
# docker-compose.yml a partir das variáveis do PostgreSQL acima
# (Host=postgres;Port=5432;Database=...;Username=...;Password=...).
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# --- SonarQube (local) ---
SONARQUBE_PORT=9000
# Login inicial padrão da imagem sonarqube:community: admin / admin.
# No primeiro acesso via http://localhost:9000 a própria interface exige a troca de senha.
